# Copier vers `.env` (Docker) et/ou `apps/api/.env` (dev npm local)
# Ne committez jamais de vrais secrets.

# ── MongoDB ──────────────────────────────────────────────
# Dev npm local :
MONGODB_URI=mongodb://127.0.0.1:27017/orgmymiam
# Docker Compose écrase cette valeur avec mongodb://mongo:27017/orgmymiam

# ── JWT (générer des secrets aléatoires en prod) ─────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── API ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
# Dev Vite : http://localhost:5173
# Docker (nginx web) : http://localhost:8080
CORS_ORIGIN=http://localhost:5173
CATALOG_VERSION=1
NODE_ENV=development

# ── Docker Compose (optionnel) ───────────────────────────
# WEB_PORT=8080
# MONGO_PORT=27017
# Origine CORS vue par le navigateur derrière nginx (défaut http://localhost:8080)
# DOCKER_CORS_ORIGIN=http://localhost:8080
# SKIP_SEED=0
