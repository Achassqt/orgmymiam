# Copier vers apps/api/.env pour le développement local

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/orgmymiam

# JWT (générer des secrets aléatoires en prod)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Catalogue
CATALOG_VERSION=1
